# Pip server configuration — every setting the server reads, with its
# default. All variables use the PIP_ prefix.
#
# Production: setup.sh writes the real file to /opt/pipvoice/env (chmod 600)
# and systemd loads it via EnvironmentFile= (see systemd/pipvoice.service).
# Local dev: export what you need in the shell (see SETUP-LOCAL-MAC.md).

# ---- core ------------------------------------------------------------
# Public origin of this deployment. Required in practice: device
# provisioning refuses to run without it, OTA manifests and every email
# link derive from it, and session cookies are only marked Secure when
# it is https.
PIP_BASE_URL=https://voice.example.com

# Data directory: SQLite DB, message audio, firmware uploads, rendered
# themes, VAPID key. Local dev wants a writable path, e.g. $PWD/data.
PIP_DATA=/opt/pipvoice/data

# ---- messages --------------------------------------------------------
# Max recording length (seconds); mirrors the firmware's limit.
PIP_MAX_MSG_S=90
# Undelivered messages are deleted after this many days.
PIP_RETENTION_DAYS=30
# Phone-user rows are deleted this many hours after first ack (grace so
# a second PWA on the same account can still fetch).
PIP_DELIVERED_GRACE_H=24
# "You have an unheard message" email nudge after this many hours.
PIP_REMIND_H=12

# ---- analytics (admin Analytics page) --------------------------------
# Detail (event log + hourly counters) is kept this many days; daily
# totals are kept forever.
PIP_STATS_DAYS=7
# A box counts as offline after this many quiet minutes (boxes poll
# every 15; two misses plus slack).
PIP_OFFLINE_MIN=40

# ---- MQTT (server <-> broker; leave defaults for the single-VPS setup)
PIP_MQTT_HOST=127.0.0.1
PIP_MQTT_PORT=1883
PIP_MQTT_USER=server
PIP_MQTT_PASS=
# mosquitto credential/ACL files the server rewrites on provisioning
PIP_MQTT_PASSWD=/etc/mosquitto/pipvoice/passwd
PIP_MQTT_ACL=/etc/mosquitto/pipvoice/acl
# What provisioned devices are told to connect to. Defaults to the
# PIP_BASE_URL host on 8883 — override only for split deployments.
#PIP_MQTT_PUBLIC_HOST=
#PIP_MQTT_PUBLIC_PORT=8883

# Note: there is no "self-hosted mode" switch. A deployment counts as
# self-hosted unless PIP_BASE_URL points at the hosted instance's domain
# (db.hosted()); self-hosted servers get no public waitlist signup and
# self-host wording on the landing/privacy pages, automatically.

# ---- auth ------------------------------------------------------------
# 1 = enable local passwords (self-host): the admin sets per-user
# passwords in /admin, the login screens offer password sign-in, and a
# family can skip SMTP entirely. Off by default (email codes only, and
# any stored password hashes are blanked at boot).
#PIP_LOCAL_AUTH=1

# ---- email (login codes + notify fallback; blank = email disabled) ---
PIP_SMTP_HOST=
PIP_SMTP_PORT=587
PIP_SMTP_USER=
PIP_SMTP_PASS=
# Defaults to PIP_SMTP_USER, or pip@localhost
#PIP_SMTP_FROM=Pip <pip@voice.example.com>

# ---- firmware releases -----------------------------------------------
# Manifest the admin "Fetch latest release" button pulls from. Defaults
# to the upstream project's latest GitHub Release; point it at your own
# fork's releases (or any static host) if you build your own firmware.
#PIP_RELEASE_MANIFEST=https://github.com/jpmreis/pipvoice/releases/latest/download/manifest.json

# ---- web push --------------------------------------------------------
# VAPID contact sent to push services; defaults to pip@<PIP_BASE_URL host>
#PIP_VAPID_SUBJECT=mailto:you@example.com
# Private key location; auto-generated on first use. Regenerating it
# invalidates every existing push subscription — keep it safe.
#PIP_VAPID_PEM=/opt/pipvoice/data/vapid_private.pem
