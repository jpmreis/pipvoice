# Settings for the Docker Compose self-host stack (docker-compose.yml).
# Copy to .env and edit. Full server settings: server/env.example;
# walkthrough: docs/SELF-HOSTING.md

# Your domain, already pointing at this machine (A record). HTTPS is a
# hard requirement — PWA install and the web flasher need it.
DOMAIN=voice.example.com

# The app's own broker account. Any long random string:
#   openssl rand -base64 18
MQTT_SERVER_PASS=

# Local passwords (default on for self-hosts): sign in without SMTP.
PIP_LOCAL_AUTH=1

# Optional: outgoing email (sign-in codes, install invites, "unheard
# message" nudges). Leave unset to run without email entirely.
#PIP_SMTP_HOST=smtp.resend.com
#PIP_SMTP_PORT=587
#PIP_SMTP_USER=resend
#PIP_SMTP_PASS=
#PIP_SMTP_FROM=Pip <pip@voice.example.com>
